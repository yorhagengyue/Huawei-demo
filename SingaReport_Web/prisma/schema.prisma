// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id         String  @id @default(uuid())
  username   String  @unique
  email      String  @unique
  password   String // In actual application, should store hash values
  name       String?
  role       String  @default("USER") // User roles: USER, ADMIN, MODERATOR
  phone      String?
  avatar     String? // User avatar URL
  bio        String? // Personal bio
  address    String? // Address
  postalCode String? // Postal code

  // Singapore specific fields
  preferredLanguage   String? @default("english") // Preferred language: english, chinese, malay, tamil
  residentialStatus   String? // Residential status: citizen, pr, work_pass, dependent_pass etc.
  singaporePostalCode String? // Singapore postal code (6 digits)

  // Account settings
  notificationsEnabled Boolean @default(true) // Whether notifications are enabled
  emailNotifications   Boolean @default(true) // Email notifications
  pushNotifications    Boolean @default(false) // Push notifications
  smsNotifications     Boolean @default(false) // SMS notifications
  twoFactorEnabled     Boolean @default(false) // Two-factor authentication

  // User status
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLogin     DateTime?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  reports    Report[] // Reports created by user
  uploadLogs UploadLog[] // User's upload logs
  files      File[] // Files uploaded by user
}

// Report model
model Report {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String
  status      String   @default("pending") // pending, in_progress, resolved, rejected
  location    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Associated with the user who created this report
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Media files for the report
  media Media[]
  files File[] // Files associated with the report

  // Demo data flag
  isDemo Boolean @default(false) // Whether it is demo data
}

// Media file model
model Media {
  id        String   @id @default(uuid())
  type      String // image, video
  url       String
  createdAt DateTime @default(now())

  // Associated with report
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Demo data flag
  isDemo Boolean @default(false) // Whether it is demo data
}

// File model (new)
model File {
  id               String    @id @default(uuid())
  fileName         String
  fileSize         Int
  fileType         String
  contentType      String
  storageType      String    @default("local") // local, huawei_obs, etc.
  storagePath      String // Storage path
  publicUrl        String? // Public access URL
  checksum         String? // File checksum
  status           String    @default("active") // active, deleted, quarantined
  downloadCount    Int       @default(0) // Download count
  lastDownloadedAt DateTime? // Last downloaded time

  // Content security
  scanStatus String? // clean, infected, pending
  scanResult String? // Scan result details

  // Associations
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id])

  // Audit and metadata
  metadata  Json? // Additional metadata
  tags      String[]
  isDemo    Boolean   @default(false) // 标记是否为演示数据
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Associated upload log
  uploadLog UploadLog?
}

// Upload log model (new - complies with Singapore audit requirements)
model UploadLog {
  id String @id @default(uuid())

  // Upload file information
  fileId       String? @unique // May be null indicating upload failure
  file         File?   @relation(fields: [fileId], references: [id])
  originalName String // Original file name
  fileSize     Int
  fileType     String

  // Operator information
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  ipAddress String
  userAgent String

  // Upload status
  status       String // SUCCESS, FAILED, REJECTED_SIZE, REJECTED_TYPE, etc.
  errorMessage String? // Error message if failed

  // PDPA compliance information
  containsPII Boolean @default(false) // Whether it contains personally identifiable information
  dataConsent Boolean @default(false) // Whether user consents to data processing

  // Singapore specific audit information
  requestId         String? // Associated request ID
  processingTime    Int? // Processing time (milliseconds)
  sourceSystem      String? // Source system
  destinationSystem String? // Destination system

  // Timestamps
  createdAt DateTime @default(now())

  // Metadata
  metadata Json?
}

// File scan results (new - security checks)
model FileScanResult {
  id            String   @id @default(uuid())
  fileId        String   @unique
  scanProvider  String // Scan provider (e.g.: IMDA certified scanning service)
  scanDate      DateTime
  status        String // clean, infected, suspicious
  threatDetails Json?
  quarantined   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// File access log (new - access audit)
model FileAccessLog {
  id         String   @id @default(uuid())
  fileId     String
  userId     String? // May be anonymous access
  ipAddress  String
  userAgent  String
  accessType String // view, download, share
  accessTime DateTime @default(now())

  // Singapore specific fields
  geoLocation  String? // Geographic location
  isSuspicious Boolean @default(false) // Whether it's suspicious access
}
