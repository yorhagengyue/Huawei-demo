# Environment Variables Configuration

# 简化数据库连接设置 - 使用PostgreSQL 15
DATABASE_URL="postgresql://user:password@localhost:5432/singareport?schema=public"

# JWT配置
JWT_SECRET="your_jwt_secret_key_here"

# 调试模式
DEBUG_MODE="true"

# 应用程序配置
APP_NAME="SingaReport"
APP_ENV="development"

# Google Maps API配置
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here" 